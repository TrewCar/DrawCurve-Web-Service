@page "/login"
@using DrawCurve.Client.Service
@using DrawCurve.Domen.Models
@using DrawCurve.Domen.Responces
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject IJSRuntime JsRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page-container">
    <section class="login">
        <div class="banner">
            <img class="image" src="images/Saly-13.png" />
        </div>
        <EditForm class="form" Model="@loginModel" OnValidSubmit="HandleLogin">
            <h3 class="title">Welcome to <span class="gradient-text">Gen-Video</span></h3>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="inputs-wrap">
                <div class="input-wrap">
                    <!-- <label for="username" class="label">Username</label> -->
                    <img class="input-icon" src="images/ic_email.svg"/>
                    <InputText id="username" class="input retro-border" @bind-Value="loginModel.Login" placeholder="Enter your username" />
                </div>
                <div class="input-wrap">
                    <!-- <label for="password" class="label">Password</label> -->
                    <img class="input-icon" src="images/ic_password.svg"/>
                    <InputText id="password" class="input retro-border" @bind-Value="loginModel.Password" placeholder="Enter your password" type="password" />
                </div>
                <button type="submit" class="button retro-border">Login</button>
            </div>
        </EditForm>
    </section>
</div>

<style>
    .page-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .login {
        display: flex;
        column-gap: 30px;
        max-width: 60vw;
        overflow: hidden;
        background: radial-gradient(#e54c9181, #f48b7b3d);
        border-radius: 50px;
    }

    .banner {
        width: 35%;
        background: linear-gradient(#E54C91, #F48B7B, #F7AD50);
        border-radius: 50px;
        box-shadow: 5px 0 40px 10px #00000042;
    }

    .image {
        width: 150%;
        max-width: 150%;
    }

    .form {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        row-gap: 30px;
        width: auto;
        padding: 35px;
    }

    .title {
        font-weight: 700;
        font-size: 3em;
    }

    .inputs-wrap {
        align-self: flex-end;
        display: flex;
        flex-direction: column;
        row-gap: 50px;
        width: 80%;
    }

    .input-wrap {
        align-self: flex-end;
        position: relative;
        display: flex;
        align-items: center;
        width: max-content;
    }

    .input {
        font-size: 2em;
        background-color: transparent;
        padding: 15px 2.6rem 15px 10px;
    }

    .input::placeholder {
        color: #4f4f4f;
    }

    .input-icon {
        position: absolute;
        right: 10px;
        width: 2rem;
    }

    .button {
        font-size: 2em;
        align-self: flex-end;
        padding: 10px 40px;
    }

    .retro-border {
        border: 2px black solid;
        box-shadow: 4px 8px 0 8px black;
        border-radius: 10px;
    }

    .gradient-text {
         background: linear-gradient(45deg, #F7AD50, #EB4335);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>



@code {
    private UserResource loginModel = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Если пользователь уже авторизован, перенаправляем его на другую страницу
        if (user.Identity?.IsAuthenticated ?? false)
        {
            Navigation.NavigateTo("/userinfo");
        }
    }

    private async Task HandleLogin()
    {
        try
        {
            var response = await AuthService.LoginAsync(loginModel);
            Navigation.NavigateTo("/userinfo", true);
        }
        catch
        {
            await JsRuntime.InvokeVoidAsync("alert", "Incorrect login or password"); // Alert
            loginModel.Password = "";
        }
    }
}
