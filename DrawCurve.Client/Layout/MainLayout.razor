@inherits LayoutComponentBase
@inject AuthService authService
<div class="page">
    <NavMenu />

    <main>
        <div class="header">
            <AuthorizeView>
                <NotAuthorized>
                    <NavLink class="header__button gradient-text" href="Login">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </NavLink>
                    <NavLink class="header__button gradient-text" href="Registration">
                        <i class="bi bi-person-plus"></i> Registration
                    </NavLink>
                </NotAuthorized>
                <Authorized>
                    <button class="header__button gradient-text" @onclick="logOut">
                        <i class="bi bi-box-arrow-right"></i> Log Out
                    </button>
                </Authorized>
            </AuthorizeView>

        </div>


        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
@code {
    private void logOut()
    {
        authService.LogoutAsync();
    }
}